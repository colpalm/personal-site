{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "themes/cp-theme/assets/**",
      "!themes/cp-theme/assets/lib", // vendored Chart.js
      "!themes/cp-theme/assets/css/syntax" // generated by hugo gen chromastyles
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // The theme consistently uses function expressions; converting them is churn, not a fix
      "complexity": {
        "useArrowFunction": "off"
      },
      // The stylesheet orders dark-theme overrides after base rules on purpose
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "indentWidth": 4,
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded"
    }
  },
  "css": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
